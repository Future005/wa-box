# WA Box settings for running on your own computer (docker-compose.local.yml).
# Copy to .env and fill in. scripts/setup.sh (Mac/Linux) or scripts/setup.ps1 (Windows) does this for you.
# Never commit .env.

# Shared secret between the app and the WhatsApp engine. Any long random string.
# Make one with:  openssl rand -hex 32
WA_ENGINE_KEY=

# First admin account. You'll be asked to choose a new password on first sign-in.
ADMIN_USER=admin
# Leave empty to get a one-time password printed in the logs:
#   docker compose -f docker-compose.local.yml logs wabox | grep "One-time password"
ADMIN_PASSWORD=

# Optional: your organisation's name, shown next to "WA Box".
ORG_NAME=

# Optional: only offer WhatsApp groups whose names contain one of these words (comma-separated).
# Recommended if your phone is in hundreds of groups. Can be changed later in the app.
GROUP_KEYWORDS=

# Port on this computer: the app opens at http://localhost:3000
PORT=3000

# Safety limits (can also be changed in the app under Safety & settings)
DAILY_CAP=30
MAX_LATE_MINUTES=120

# Times are shown and scheduled in India time (Asia/Kolkata).
TZ=Asia/Kolkata
